{
  "manifest_version": 3,
  "name": "GhostMarket AI & Jarvis Automação",
  "version": "2.0",
  "description": "Motor de automação, rastreamento e auto-postagem do Jarvis e GhostMarket AI",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.shopee.com.br/*",
    "*://firestore.googleapis.com/*",
    "http://localhost:*/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:*/*", "https://*.vercel.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.tiktok.com/creator-center/upload*", "*://*.tiktok.com/upload*"],
      "js": ["tiktok_poster.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
